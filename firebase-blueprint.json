{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Registered institutional school buyer profile",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "fullName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 30 },
        "institutionName": { "type": "string", "maxLength": 150 },
        "institutionType": { "type": "string", "maxLength": 80 },
        "city": { "type": "string", "maxLength": 80 },
        "deliveryAddress": { "type": "string", "maxLength": 300 },
        "role": { "type": "string", "enum": ["school_buyer", "dealer", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "fullName", "email", "institutionName", "city"]
    },
    "Quotation": {
      "title": "Quotation",
      "description": "School furniture quotation request",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 100 },
        "institutionName": { "type": "string", "maxLength": 150 },
        "email": { "type": "string", "format": "email", "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 30 },
        "city": { "type": "string", "maxLength": 80 },
        "deliveryAddress": { "type": "string", "maxLength": 300 },
        "notes": { "type": "string", "maxLength": 1000 },
        "totalEstimatedUnits": { "type": "number" },
        "status": { "type": "string", "enum": ["Pending Review", "Under Quotation", "Approved", "Dispatched"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "customerName", "institutionName", "email", "phone", "city", "status"]
    },
    "CustomOrderInquiry": {
      "title": "CustomOrderInquiry",
      "description": "Bespoke dimensions or bulk tender inquiry",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "fullName": { "type": "string", "maxLength": 100 },
        "schoolName": { "type": "string", "maxLength": 150 },
        "email": { "type": "string", "format": "email", "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 30 },
        "city": { "type": "string", "maxLength": 80 },
        "projectScope": { "type": "string", "maxLength": 100 },
        "estimatedUnits": { "type": "number" },
        "notes": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "fullName", "schoolName", "email", "phone", "city"]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "General inquiry or contact message from website visitor",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 30 },
        "subject": { "type": "string", "maxLength": 150 },
        "message": { "type": "string", "maxLength": 1500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "email", "message"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Institutional user profiles with PII access control"
    },
    "/quotations/{quotationId}": {
      "schema": "Quotation",
      "description": "Quotation requests submitted by schools and buyers"
    },
    "/custom_inquiries/{inquiryId}": {
      "schema": "CustomOrderInquiry",
      "description": "Bespoke furniture tender and custom inquiry records"
    },
    "/contact_messages/{messageId}": {
      "schema": "ContactMessage",
      "description": "Website contact form submissions"
    }
  }
}
